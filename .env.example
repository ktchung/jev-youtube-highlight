# Copy to .env at the repository root. The helper reads it on startup.
# Keep the key here only; extension build tools never read this file.
JEV_API_KEY=
JEV_MODEL=jev-1.14.0
HELPER_PORT=8765
JEV_MAX_CONCURRENCY=4

# Optional tuning. Prices are estimates in USD; check your TypeSafe account.
JEV_TIMEOUT_SECONDS=45
JEV_INPUT_COST_PER_MILLION=0.042
JEV_OUTPUT_COST_PER_MILLION=0
# HELPER_CACHE_PATH=/absolute/path/to/cache.sqlite3
# Extra caption retrieval path; install helper's fallback extra before enabling.
HELPER_ENABLE_YTDLP_FALLBACK=false
# Permit browser dev servers on localhost only when explicitly enabled.
HELPER_ALLOW_LOCALHOST_ORIGINS=false
