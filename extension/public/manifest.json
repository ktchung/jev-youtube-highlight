{
  "manifest_version": 3,
  "name": "Jev · YouTube Highlights",
  "version": "0.1.0",
  "description": "Mark promotional and unrelated passages on YouTube with Jev. Playback stays in your hands.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Jev Highlights" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
    "js": ["page.js"],
    "world": "MAIN",
    "run_at": "document_start"
  }, {
    "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
